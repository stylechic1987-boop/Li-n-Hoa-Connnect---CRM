rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function p(){return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;}
    function manager(){return signedIn() && p().role in ['company_director','admin','branch_director','center_director'];}
    match /profiles/{uid}{allow read: if signedIn() && (request.auth.uid==uid || manager()); allow write: if signedIn() && (request.auth.uid==uid || p().role in ['company_director','admin']);}
    match /employees/{id}{allow read: if signedIn() && (manager() || resource.data.user_id==request.auth.uid); allow create,update: if manager();}
    match /attendance/{id}{allow read,write: if signedIn() && (manager() || request.resource.data.user_id==request.auth.uid || resource.data.user_id==request.auth.uid);}
    match /classes/{id}{allow read: if signedIn() && (manager() || resource.data.teacher_user_id==request.auth.uid); allow create,update: if manager();}
    match /students/{id}{allow read,write: if signedIn();}
    match /sessions/{id}{allow read,write: if signedIn();}
    match /classAttendance/{id}{allow read,write: if signedIn();}
  }
}